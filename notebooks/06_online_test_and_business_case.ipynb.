        "# LiftLens: Online Test Design and Business Case\n",
        "Goal: design the live experiment that proves LiftLens works, and quantify the business case."
      ],
      "metadata": {
        "id": "WGkCPKRUsnni"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from scipy.stats import norm\n",
        "import numpy as np\n",
        "\n",
        "# ---- Inputs from earlier lessons ----\n",
        "VALUE_PER_VISIT = 55.74              # Lesson 10 (₹ profit per extra visit)\n",
        "VISIT_RATE = 0.0485                  # treated visit rate, Lesson 8\n",
        "PROFIT_POLICY = 29_218 / 100_000     # Lesson 11 holdout, ₹ per user\n",
        "PROFIT_EVERYONE = 5_104 / 100_000    # Lesson 11 holdout, ₹ per user\n",
        "\n",
        "# ---- Assumptions (state them openly) ----\n",
        "DAILY_USERS = 200_000                # eligible users per day\n",
        "ARM_SHARE = 0.45                     # share of users in each main arm\n",
        "TEST_DAYS = 14                       # two full weeks, to cover weekday/weekend patterns\n",
        "\n",
        "z = norm.ppf(0.975) + norm.ppf(0.80)                     # 95% confidence, 80% power\n",
        "sd = VALUE_PER_VISIT * np.sqrt(VISIT_RATE * (1 - VISIT_RATE))\n",
        "gain = PROFIT_POLICY - PROFIT_EVERYONE\n",
        "\n",
        "def n_per_arm(diff):\n",
        "    return int(np.ceil(2 * sd**2 * z**2 / diff**2))\n",
        "\n",
        "print(f\"Expected profit gain: ₹{gain:.3f} per user\\n\")\n",
        "for label, d in [('the full expected gain', gain), ('half the expected gain', gain / 2)]:\n",
        "    n = n_per_arm(d)\n",
        "    print(f\"To detect {label}: {n:,} users per arm (~{n / (DAILY_USERS * ARM_SHARE):.1f} days)\")\n",
        "\n",
        "n_test = int(DAILY_USERS * ARM_SHARE * TEST_DAYS)\n",
        "mde_profit = z * sd * np.sqrt(2 / n_test)\n",
        "mde_visit = z * np.sqrt(2 * VISIT_RATE * (1 - VISIT_RATE) / n_test)\n",
        "\n",
        "print(f\"\\nA {TEST_DAYS}-day test gives {n_test:,} users per arm, so it can detect:\")\n",
        "print(f\"  a profit difference of ₹{mde_profit:.3f} per user ({mde_profit / gain:.0%} of the expected gain)\")\n",
        "print(f\"  a visit-rate difference of {mde_visit * 100:.3f} pp (guardrail check)\")\n",
        "\n",
        "print(\"\\nPlanned looks (O'Brien-Fleming, two looks):\")\n",
        "print(\"  Day 7:  stop early only if |z| > 2.797  (p < 0.005)\")\n",
        "print(\"  Day 14: final decision if |z| > 1.977   (p < 0.048)\")"
      ],
